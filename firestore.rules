rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
      );
      // Plan fields are written only by the server after a verified payment.
      allow create: if request.auth != null && request.auth.uid == userId
        && (!('plan' in request.resource.data) || request.resource.data.plan == 'free')
        && (!('role' in request.resource.data) || request.resource.data.role != 'admin');
      allow update: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" ||
        (request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan', 'role', 'planExpiresAt', 'planOrderId', 'planPaymentId', 'planUpdatedAt']))
      );
      allow delete: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
      );
      
      match /progress/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /bookmarks/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /feedProgress/{cardId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /srs/{id} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /quickCardState/{cardId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Case Presentation: saved case sheets. Only subscribers (Scholar / Clinician) and admins can create or edit.
      match /caseSheets/{sheetId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.plan in ["basic", "pro"]
        );
      }
    }
    match /subjects/{subjectId} {
      allow read: if true;
      allow write, delete: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      
      match /topics/{topicId} {
        allow read: if true;
        allow write, delete: if request.auth != null && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }
      match /mindmaps/{mindmapId} {
        allow read: if true;
        allow write, delete: if request.auth != null && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }
      match /flashcardDecks/{deckId} {
        allow read: if true;
        allow write, delete: if request.auth != null && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }
      match /essayChapters/{chapterId} {
        allow read: if true;
        allow write, delete: if request.auth != null && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';

        match /sections/{sectionId} {
          allow read: if true;
          allow write, delete: if request.auth != null && 
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        }
      }
      match /flashcardDecks/{deckId} {
        allow read: if true;
        allow write, delete: if request.auth != null && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }
      match /qbankQuestions/{questionId} {
        allow read: if true;
        allow write, delete: if request.auth != null && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }
      match /textNotes/{noteId} {
        function me() {
          return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        }
        function isAdminUser() {
          return 'role' in me() && me().role == 'admin';
        }
        function paidAndActive() {
          return 'plan' in me() && me().plan in ['basic', 'pro'] && (!('planExpiresAt' in me()) || me().planExpiresAt > request.time.toMillis());
        }
        function isFreeSample() {
          return exists(/databases/$(database)/documents/notesIndex/$(subjectId + '__' + noteId))
            && get(/databases/$(database)/documents/notesIndex/$(subjectId + '__' + noteId)).data.free == true;
        }
        // Note text: signed-in AND (free-sample chapter OR admin OR paid plan not expired)
        allow read: if request.auth != null && (isFreeSample() || isAdminUser() || paidAndActive());
        allow write, delete: if request.auth != null && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }
      match /notesPdfIngestJob/{jobId} {
        allow read, write: if request.auth != null && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }
      match /aiNotesGenJob/{jobId} {
        allow read, write: if request.auth != null && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }
      match /mindmapFromNotesJob/{jobId} {
        allow read, write: if request.auth != null && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }
      match /flashcardFromNotesJob/{jobId} {
        allow read, write: if request.auth != null && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }
    }
    match /notesPdfSources/{sourceId} {
      allow read, write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /notes/{noteId} {
      allow read: if request.auth != null;
      allow write, delete: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /videos/{videoId} {
      allow read: if request.auth != null;
      allow write, delete: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /mindmaps/{mindmapId} {
      allow read: if request.auth != null;
      allow write, delete: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /cases/{caseId} {
      allow read: if true;
      allow write, delete: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /osceStations/{stationId} {
      allow read: if true;
      allow write, delete: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /osceStationGenJob/{jobId} {
      allow read, write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /quickCards/{cardId} {
      allow read: if resource.data.status == 'published' || (request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      allow create, update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /quickCardSettings/{slug} {
      allow read: if true;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /dashboardBanners/{bannerId} {
      allow read: if true;
      allow write, delete: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /pyqQuestions/{docId} {
      allow read: if request.auth != null;
      allow write, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /pyqImages/{docId} {
      allow read: if request.auth != null;
      allow write, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /pyqMeta/{docId} {
      allow read: if request.auth != null;
      allow write, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /profpyq/{docId} {
      allow read: if true;
      allow write, delete: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    // The 100 Most Important Topics (note text). Only Scholar / Clinician members (plan not expired) and admins can read.
    match /top100Notes/{noteId} {
      function me() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      }
      function isAdminUser() {
        return 'role' in me() && me().role == 'admin';
      }
      function paidAndActive() {
        return 'plan' in me() && me().plan in ['basic', 'pro'] && (!('planExpiresAt' in me()) || me().planExpiresAt > request.time.toMillis());
      }
      allow read: if request.auth != null && (isAdminUser() || paidAndActive());
      allow write, delete: if request.auth != null && isAdminUser();
    }
    // Light chapter index (titles and topic names only, no note text). Signed-in users read it; admins write it.
    match /notesIndex/{indexId} {
      allow read: if request.auth != null;
      allow write, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /top100/{topicId} {
      allow read: if true;
      allow write, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /notePacks/{packId} {
      allow read: if true;
      allow write, delete: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /notePackPurchases/{purchaseId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if false;
    }
    match /pageViews/{eventId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow read: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
      allow update, delete: if false;
    }
    match /bulkMindmapJobs/{jobId} {
      allow read, write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }
    match /bulkLongAnswerJobs/{jobId} {
      allow read, write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }
    match /extractedQuestionBanks/{subjectId} {
      allow read, write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }
    match /bulkQbankJobs/{jobId} {
      allow read, write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }
    match /flashcardFromNotesJobs/{jobId} {
      allow read, write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }
    match /mindmapFromNotesJobs/{jobId} {
      allow read, write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }
    match /qbankFromNotesJobs/{jobId} {
      allow read, write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }
    match /notesRepairJobs/{jobId} {
      allow read, write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }
    match /bulkFlashcardJobs/{jobId} {
      allow read, write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";

      match /queueItems/{itemId} {
        allow read, write: if request.auth != null && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
      }
    }
    match /textbooks/{textbookId} {
      allow read, write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";

      match /chapters/{chapterId} {
        allow read, write: if request.auth != null && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
      }
    }
    // Arena (multiplayer): every write goes through the Admin SDK API routes.
    match /rooms/{roomId} { allow read: if request.auth != null; allow write: if false; }
    match /arenaStats/{uid} { allow read: if request.auth != null; allow write: if false; }
    match /roomSecrets/{id} { allow read, write: if false; }
    match /arenaMeta/{id} { allow read, write: if false; }
    // Spot & Identify items uploaded from Admin > Spotters upload.
    match /spotters/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }
    // Support inbox: signed-in users can send a message; only admins read, resolve or delete.
    match /supportRequests/{id} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }
    // Question reports from students (used by the Report button in QBank).
    match /questionReports/{id} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }
  }
}
